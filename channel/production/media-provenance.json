    "space-measured": {
      "duration": 46.32,
      "captions": [
        {
          "start": 0.0,
          "end": 2.74009,
          "text": "About a thousand light-years away,"
        },
        {
          "start": 2.81007,
          "end": 7.83955,
          "text": "a cloud called IC 348 is making stars,"
        },
        {
          "start": 7.90952,
          "end": 10.21079,
          "text": "and much smaller objects."
        },
        {
          "start": 10.42077,
          "end": 15.64526,
          "text": "NASA reports that Webb observations have identified brown dwarfs"
        },
        {
          "start": 15.71524,
          "end": 19.08213,
          "text": "with masses as low as twice Jupiter’s."
        },
        {
          "start": 19.29211,
          "end": 22.42104,
          "text": "Brown dwarfs form much like stars,"
        },
        {
          "start": 22.49102,
          "end": 27.25111,
          "text": "but cannot sustain the ordinary hydrogen fusion that powers them."
        },
        {
          "start": 27.46109,
          "end": 32.55351,
          "text": "These unusually small examples challenge existing formation models."
        },
        {
          "start": 32.76349,
          "end": 39.02127,
          "text": "The observations also show young stars sending jets into surrounding material."
        },
        {
          "start": 39.23125,
          "end": 46.03442,
          "text": "The discovery gives researchers a closer look at how varied stellar nurseries can be."
        }
      ],
