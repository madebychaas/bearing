    "nature-measured": {
      "duration": 45.61,
      "captions": [
        {
          "start": 0.0,
          "end": 6.26735,
          "text": "Healthy fisheries begin with places where fish can feed, grow, and reproduce."
        },
        {
          "start": 6.47732,
          "end": 12.94408,
          "text": "NOAA Fisheries says it has awarded 103 million dollars to sixteen"
        },
        {
          "start": 13.01406,
          "end": 17.01506,
          "text": "habitat restoration projects across the country."
        },
        {
          "start": 17.22503,
          "end": 21.12853,
          "text": "The work includes planting corals in the Caribbean,"
        },
        {
          "start": 21.1985,
          "end": 23.70168,
          "text": "reconnecting rivers for salmon,"
        },
        {
          "start": 23.77166,
          "end": 28.52834,
          "text": "and restoring salt marsh habitat for shrimp and oysters."
        },
        {
          "start": 28.73832,
          "end": 30.86444,
          "text": "These are funding awards,"
        },
        {
          "start": 30.93442,
          "end": 33.50023,
          "text": "rather than completed recoveries."
        },
        {
          "start": 33.7102,
          "end": 36.65914,
          "text": "The next chapter is the work itself:"
        },
        {
          "start": 36.72912,
          "end": 40.51342,
          "text": "rebuilding the habitats that support aquatic life,"
        },
        {
          "start": 40.5834,
          "end": 45.34023,
          "text": "and tracking what changes as those projects move forward."
        }
      ],
