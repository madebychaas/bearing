    "culture-measured": {
      "duration": 43.57,
      "captions": [
        {
          "start": 0.0,
          "end": 1.22816,
          "text": "In Washington,"
        },
        {
          "start": 1.29814,
          "end": 8.58966,
          "text": "an exhibition invites visitors to follow the journeys of Islamic artworks across centuries."
        },
        {
          "start": 8.79964,
          "end": 13.70639,
          "text": "The Louvre and the Smithsonian’s National Museum of Asian Art are"
        },
        {
          "start": 13.77637,
          "end": 21.5371,
          "text": "presenting objects connected to places stretching from Spain to India. Alongside their craftsmanship,"
        },
        {
          "start": 21.60707,
          "end": 25.30921,
          "text": "the exhibition considers how diplomacy, collecting,"
        },
        {
          "start": 25.37918,
          "end": 29.16404,
          "text": "and movement between owners shaped their meaning."
        },
        {
          "start": 29.37401,
          "end": 37.47864,
          "text": "Its announced run began September twenty-sixth and continues through January eighteenth, twenty twenty-seven."
        },
        {
          "start": 37.68862,
          "end": 43.30095,
          "text": "The focus is both the objects themselves and the histories they carry."
        }
      ],
